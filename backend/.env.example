# Port number for the API server
PORT=5000

# Secret key used for signing JWT login tokens
JWT_SECRET=news-portal-secret-key-change-in-production

# CORS allowed origin (frontend url)
CORS_ORIGIN=http://localhost:5173

# Environment setting (development/production)
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/newsportal
